{
    "name": "jayanta/laravel-threat-detection",
    "description": "Real-time threat detection and security logging for Laravel applications. Detects SQL injection, XSS, DDoS, scanner bots, and more.",
    "keywords": [
        "laravel",
        "security",
        "threat-detection",
        "intrusion-detection",
        "xss",
        "sql-injection",
        "ddos",
        "middleware",
        "logging"
    ],
    "homepage": "https://github.com/jay123anta/laravel-threat-detection",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jay Anta",
            "email": "jay123anta@gmail.com",
            "homepage": "https://github.com/jay123anta"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.5",
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required by threat-detection:enrich and the Slack webhook fallback (^7.5). Detection itself needs no HTTP client.",
        "laravel/slack-notification-channel": "Required for Slack notifications on Laravel 11+ (^3.0)",
        "laravel/sanctum": "Recommended for API route authentication (^3.0|^4.0)"
    },
    "autoload": {
        "psr-4": {
            "JayAnta\\ThreatDetection\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JayAnta\\ThreatDetection\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JayAnta\\ThreatDetection\\ThreatDetectionServiceProvider"
            ],
            "aliases": {
                "ThreatDetection": "JayAnta\\ThreatDetection\\Facades\\ThreatDetection"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
